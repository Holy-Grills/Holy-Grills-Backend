NODE_ENV=development
PORT=4000
HOST=0.0.0.0
API_BASE_URL=http://localhost:4000
CORS_ORIGINS=http://localhost:3000,http://localhost:3001,http://localhost:3002,http://localhost:3003

# Supabase Postgres.
# Use the pooled connection string for normal API queries.
DATABASE_URL=postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres?pgbouncer=true

# Use the direct Supabase database connection for Prisma migrations.
DIRECT_URL=postgresql://postgres:[password]@db.[project-ref].supabase.co:5432/postgres

# Hosted Redis connection string. Use redis:// or rediss:// depending on provider.
REDIS_URL=redis://default:password@host:6379

# IANA timezone used for operating-hours current status.
STORE_TIMEZONE=Africa/Lagos

# Custom Holy Grills auth. Supabase is used as Postgres, not as the auth authority.
JWT_ACCESS_SECRET=replace-with-long-random-access-secret
JWT_REFRESH_SECRET=replace-with-long-random-refresh-secret
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=30d
ADMIN_BOOTSTRAP_TOKEN=replace-with-one-time-admin-bootstrap-token

# Direct Google OAuth credentials for "Continue with Google" when we implement it.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URL=http://localhost:4000/api/v1/auth/google/callback

PAYSTACK_SECRET_KEY=
PAYSTACK_CALLBACK_URL=http://localhost:3000/payment/callback
EMAIL_PROVIDER_API_KEY=
WEB_PUSH_PUBLIC_KEY=
WEB_PUSH_PRIVATE_KEY=

# Frontend origins/deep-link bases. These are not backend ports for roles.
# They may all point to the same frontend app during development.
APP_BASE_URL=http://localhost:3000
ADMIN_BASE_URL=http://localhost:3001
KITCHEN_BASE_URL=http://localhost:3002
RIDER_BASE_URL=http://localhost:3003
